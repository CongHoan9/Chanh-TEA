<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" type="TEXT/css" href="Menu.css">
        <script src="Menu.js" defer></script>
    </head>
    <body>
        <section class="collection">
            <div class="slide">
                <div class="Container SlideInLeft">
                    <h2>Bộ Sưu Tập Trà Của Chúng Tôi</h2>
                    <p>Khám phá các loại trà chanh thủ công được chọn lọc của chúng tôi.</p>
                </div>
            </div>
            <div class="filter-bar">
                <div class="Container filter">
                    <div class="store-context" data-module="store-resolution">
                        <div>
                            <strong id="activeStoreName">Chưa chọn cửa hàng</strong>
                            <p id="activeStoreMeta">Cho phép lấy vị trí hoặc nhập địa chỉ để hệ thống gán cửa hàng gần nhất.</p>
                        </div>
                        <button class="green-button store-context__button" type="button" data-action="open-location-panel">Chọn vị
                            trí</button>
                    </div>
                    <div class="search-box highlight">
                        <svg width="25px" height="25px" viewBox="0 0 30 24" fill="none">
                            <path d="M16.6725 16.6412L21 21M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />                      
                        </svg>
                        <input type="text" placeholder="Tìm kiếm sản phẩm...">
                    </div>
                    <div class="select-actions">
                        <div class="filter-container">
                            <input type="checkbox" id="filter-toggle" class="filter-toggle" />
                            <label for="filter-toggle" class="filter-label">
                                <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none">
                                    <path d="M17.8258 5H6.17422C5.31987 5 4.85896 6.00212 5.41496 6.65079L9.75926 11.7191C9.91461 11.9004 10 12.1312 10 12.3699V17.382C10 17.7607 10.214 18.107 10.5528 18.2764L12.5528 19.2764C13.2177 19.6088 14 19.1253 14 18.382V12.3699C14 12.1312 14.0854 11.9004 14.2407 11.7191L18.585 6.65079C19.141 6.00212 18.6801 5 17.8258 5Z"
                                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Bộ lọc</span>
                                <svg fill="gray" stroke-width="0" width="15" height="15" viewBox="0 0 24 24" fill="none">
                                    <path d="M4.29289 8.29289C4.68342 7.90237 5.31658 7.90237 5.70711 8.29289L12 14.5858L18.2929 8.29289C18.6834 7.90237 19.3166 7.90237 19.7071 8.29289C20.0976 8.68342 20.0976 9.31658 19.7071 9.70711L12.7071 16.7071C12.3166 17.0976 11.6834 17.0976 11.2929 16.7071L4.29289 9.70711C3.90237 9.31658 3.90237 8.68342 4.29289 8.29289Z"/>                              
                                </svg>
                            </label>
                            <div class="filter-menu SlideInBottom">
                                <p>Danh mục</p>
                                <form id="categoryFilter">
                                    <label class="radio-item">
                                        <input type="radio" name="category" onclick="FilterProduct('Tất cả')" checked>
                                        <span>Tất cả</span>
                                    </label>
                                    <% if (data.categories) { %>
                                        <% data.categories.forEach(cat => { %>
                                            <label class="radio-item">
                                                <input type="radio" name="category" onclick="FilterProduct('<%= cat.name %>')">
                                                <span><%= cat.name %></span>
                                            </label>
                                        <% }) %>
                                    <% } %>                         
                                </form>
                            </div>                    
                        </div>
                        <div class="select-wrapper highlight">
                            <select id="sort" onchange="SortProducts()">
                                <option value="default">Sắp xếp theo</option>
                                <option value="price-asc">Giá: Thấp đến Cao</option>
                                <option value="price-desc">Giá: Cao đến Thấp</option>
                                <option value="az">Tên: A đến Z</option>
                                <option value="za">Tên: Z đến A</option>
                            </select>
                            <svg width="20px" height="20px" viewBox="0 0 48 48" fill="none">
                                <rect width="48" height="48" fill="white" fill-opacity="0.01" />
                                <path d="M41.5 10H35.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M27.5 6V14" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M27.5 10L5.5 10" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M13.5 24H5.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M21.5 20V28" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M43.5 24H21.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M41.5 38H35.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M27.5 34V42" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M27.5 38H5.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />                          
                            </svg>
                        </div>              
                    </div>
                </div>
            </div>
        </section>

        <!-- 1. Top 3 Thịnh Hành -->
        <section class="body" style="background-color: white;">
            <div style="position: relative; max-width: 1200px; margin: 0 auto; width: 100%;">
                <!-- Floating Decorations -->
                <img src="/assets/leaf.png" class="floating-deco leaf" alt="" aria-hidden="true">
                <img src="/assets/empress.png" class="floating-deco peel" alt="" aria-hidden="true">
                
                <div class="Container">
                    <div class="header" style="text-align: left;">
                        <h2>Top 3 Thịnh Hành</h2>
                        <p>Những hương vị được yêu thích nhất của Chanh Tea</p>
                    </div>
                </div> <!-- Close Container for Top 3 header -->
            
            <div id="trending-products" class="trending-podium">
                <% if (data.products && data.products.length > 0) { %>
                    <% const trending = data.products.slice(0, 3); %>
                    <% trending.forEach((product, idx) => { %>
                        <div class="podium-step step-<%= idx + 1 %>">
                            <%- include('../partials/product-card', { product: product, extraClass: `top-${idx + 1}` }) %>
                            <div class="podium-block">
                                <span class="rank-number"><%= idx + 1 %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div class="Container"> <!-- Re-open Container for Toppings -->
            </div>
            </div> <!-- Close 1200px relative wrapper -->
        </section>
        <!-- 2. Tất cả Sản phẩm (Gallery cuộn ngang) -->
        <section class="body" style="background-color: #f8fafc; padding-bottom: 80px;">
            <div class="Container">
                <div class="header" style="text-align: left;">
                    <h2>Khám phá toàn bộ Menu</h2>
                    <p>Lướt để xem thêm các lựa chọn tuyệt vời khác</p>
                </div>
            </div>
            <!-- Scroll container outside of Container to span full width -->
            <div class="horizontal-scroll-container" style="margin: -50px 0 0 0; padding: 50px 0px;">
                <div id="gallery-products" class="gallery-track">
                    <% if (data.products) { %>
                        <% data.products.forEach(product => { %>
                            <%- include('../partials/product-card', { product: product, extraClass: 'gallery-item' }) %>
                        <% }) %>
                    <% } %>
                </div>
            </div>
            <div class="Container">
                <!-- Floating Toppings Section -->
                <div class="toppings-section">
                    <div class="header" style="text-align: left;">
                        <h2>Topping Đặc Trưng</h2>
                        <p>Thêm chút ngọt ngào cho thức uống của bạn</p>
                    </div>
                    <div id="toppings-cloud" class="toppings-cloud">
                        <% let uniqueToppings=[]; if (data.products) { data.products.forEach(p=> {
                            if (p.toppings && Array.isArray(p.toppings)) {
                            p.toppings.forEach(t => {
                            if (!uniqueToppings.includes(t)) uniqueToppings.push(t);
                            });
                            }
                            });
                            }
                            if (uniqueToppings.length === 0) {
                            uniqueToppings = ['Trân châu trắng', 'Thạch đào', 'Trân châu đen', 'Kem cheese', 'Thạch dừa', 'Nha đam',
                            'Pudding trứng'];
                            }
                            %>
                            <% uniqueToppings.forEach((t, i)=> { %>
                                <div class="topping-bubble" style="--anim-delay: <%= i * 0.2 %>s;">
                                    <span>
                                        <%= t %>
                                    </span>
                                </div>
                            <% }) %>
                    </div>
                </div>
            </div>
        </section>
        <section class="body" style="background-color: white;">
            <div class="grid center Container">
                <div class="SlideInBottom">
                    <div class="circle icon">
                        <svg stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24" fill="none">
                            <path
                                d="M2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C22 6.34315 22 8.22876 22 12C22 15.7712 22 17.6569 20.8284 18.8284C19.6569 20 17.7712 20 14 20H10C6.22876 20 4.34315 20 3.17157 18.8284C2 17.6569 2 15.7712 2 12Z" />
                            <path d="M10 16H6" />
                            <path d="M14 16H12.5" />
                            <path d="M2 10L22 10" />
                        </svg>
                    </div>
                    <h3>Thanh toán an toàn</h3>
                    <p>Tất cả các giao dịch được xử lý an toàn</p>
                </div>
                <div class="SlideInBottom">
                    <div class="circle icon">
                        <svg fill="#16a34a" stroke-width="0" viewBox="0 0 24 24" fill="none">
                            <path
                                d="M23 12C23 18.0751 18.0751 23 12 23C5.92487 23 1 18.0751 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12ZM3.00683 12C3.00683 16.9668 7.03321 20.9932 12 20.9932C16.9668 20.9932 20.9932 16.9668 20.9932 12C20.9932 7.03321 16.9668 3.00683 12 3.00683C7.03321 3.00683 3.00683 7.03321 3.00683 12Z" />
                            <path
                                d="M12 5C11.4477 5 11 5.44771 11 6V12.4667C11 12.4667 11 12.7274 11.1267 12.9235C11.2115 13.0898 11.3437 13.2343 11.5174 13.3346L16.1372 16.0019C16.6155 16.278 17.2271 16.1141 17.5032 15.6358C17.7793 15.1575 17.6155 14.5459 17.1372 14.2698L13 11.8812V6C13 5.44772 12.5523 5 12 5Z" />
                        </svg>
                    </div>
                    <h3>Giao hàng nhanh</h3>
                    <p>Giao hàng trong ngày tại Hà Nội</p>
                </div>
                <div class="SlideInBottom">
                    <div class="circle icon">
                        <svg stroke="#16a34a" stroke-width="2" viewBox="0 0 24 24" fill="none">
                            <path
                                d="M9 12L11 14L15 9.99999M20 12C20 16.4611 14.54 19.6937 12.6414 20.683C12.4361 20.79 12.3334 20.8435 12.191 20.8712C12.08 20.8928 11.92 20.8928 11.809 20.8712C11.6666 20.8435 11.5639 20.79 11.3586 20.683C9.45996 19.6937 4 16.4611 4 12V8.21759C4 7.41808 4 7.01833 4.13076 6.6747C4.24627 6.37113 4.43398 6.10027 4.67766 5.88552C4.9535 5.64243 5.3278 5.50207 6.0764 5.22134L11.4382 3.21067C11.6461 3.13271 11.75 3.09373 11.857 3.07827C11.9518 3.06457 12.0482 3.06457 12.143 3.07827C12.25 3.09373 12.3539 3.13271 12.5618 3.21067L17.9236 5.22134C18.6722 5.50207 19.0465 5.64243 19.3223 5.88552C19.566 6.10027 19.7537 6.37113 19.8692 6.6747C20 7.01833 20 7.41808 20 8.21759V12Z" />
                        </svg>
                    </div>
                    <h3>Đảm bảo chất lượng</h3>
                    <p>Không hài lòng? Chúng tôi sẽ thay thế miễn phí</p>
                </div>
            </div>
        </section>
    </body>
</html>
  
