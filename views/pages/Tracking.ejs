<div class="Container" style="padding-top: 60px; padding-bottom: 80px;">
    <div class="tracking-layout">
        <div class="tracking-top-section">
            <!-- Cột trái: Thông tin chi tiết đơn hàng -->
            <div class="tracking-left-col">
                <!-- Box chi tiết đơn hàng -->
                <div id="activeOrderDetails" style="display:none;">
                    <!-- Rendered by JS -->
                </div>
            </div>

            <!-- Cột phải: Thanh tiến trình -->
            <div class="tracking-right-col" id="activeOrderTimeline" style="min-height: 350px; padding-top: 15px;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px; margin-left:2px;">
                    <div style="width:12px; height:12px; background:#16a34a; border-radius:50%;"></div>
                    <strong style="font-size:16px;">Chưa có đơn được chọn</strong>
                </div>
                <div class="status-timeline">
                    <!-- Default inactive timeline -->
                    <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-content"><p class="status-label">Chờ xác nhận</p></div></div>
                    <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-content"><p class="status-label">Đã gán cửa hàng</p></div></div>
                    <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-content"><p class="status-label">Đang chuẩn bị</p></div></div>
                    <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-content"><p class="status-label">Đang giao</p></div></div>
                    <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-content"><p class="status-label">Đã giao</p></div></div>
                </div>
            </div>
        </div>

        <!-- Cột dưới: Danh sách các đơn của thiết bị -->
        <div class="tracking-bottom-section">
            <h3 style="margin-bottom:20px; color:#1e293b; font-size:20px;">Các đơn hàng của bạn</h3>
            <div id="trackingList" class="local-orders-list"></div>
            <div id="emptyTracking" class="empty-tracking" style="display:none;">
                <p>Bạn chưa có đơn hàng nào lưu trên thiết bị này.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-layout {
        display: flex;
        flex-direction: column;
        gap: 30px;
        margin-top: 30px;
        margin-bottom: 50px;
    }

    .tracking-top-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
    }

    @media (max-width: 768px) {
        .tracking-top-section {
            grid-template-columns: 1fr;
        }
    }

    .tracking-card {
        background: #fff;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
    }

    .lookup-form h2 {
        margin: 5px 0 15px 0;
        font-size: 24px;
        color: #1e293b;
    }

    .lookup-form p {
        color: #64748b;
        margin-bottom: 20px;
    }

    .lookup-form form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .lookup-form label {
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-weight: 500;
        color: #334155;
    }

    .lookup-form input {
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
    }
    
    .lookup-form input:focus {
        border-color: #16a34a;
    }

    .green-button {
        background: #16a34a;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        font-size: 15px;
    }

    .green-button:hover {
        background: #15803d;
    }

    .local-orders-list {
        display: flex;
        flex-direction: column;
    }

    .local-order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 10px;
        border-bottom: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.2s;
    }

    .local-order-item:last-child {
        border-bottom: none;
    }

    .local-order-item:hover {
        background: #f8fafc;
    }

    .local-order-item.active {
        background: #f0fdf4;
        border-left: 3px solid #16a34a;
        padding-left: 15px;
    }

    /* Timeline CSS */
    .status-timeline {
        display: flex;
        flex-direction: column;
    }

    .timeline-item {
        display: flex;
        gap: 20px;
        position: relative;
        padding-bottom: 25px;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 20px;
        bottom: -5px;
        width: 2px;
        background: #e2e8f0;
    }

    .timeline-item:last-child::before {
        display: none;
    }

    .timeline-dot {
        position: relative;
        z-index: 1;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #cbd5e1;
        margin-top: 2px;
    }

    .timeline-dot.complete {
        background: #16a34a;
    }

    .timeline-dot.active {
        background: #16a34a;
        box-shadow: 0 0 0 4px #dcfce7;
    }

    .timeline-content p { margin: 0; }
    .timeline-content .status-label { font-weight: 600; color: #1e293b; }
    .timeline-content .status-time { font-size: 13px; color: #64748b; margin-top: 2px; }

    .empty-tracking {
        text-align: center;
        padding: 40px 20px;
        color: #999;
        background: #fff;
        border-radius: 12px;
        border: 1px dashed #cbd5e1;
    }
</style>

<script>
    (function() {
        const STORAGE_KEY = "chanhTeaCreatedOrders";
        let localOrders = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        // Sort by created_at desc
        localOrders.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

        let currentActiveOrder = null;

        function getStatusBadge(status) {
            const statusMap = {
                "pending": "Chờ xác nhận",
                "assigned": "Đã gán cửa hàng",
                "preparing": "Đang chuẩn bị",
                "delivering": "Đang giao",
                "completed": "Đã giao",
                "cancelled": "Đã hủy"
            };
            return statusMap[status?.toLowerCase()] || "Chưa xác định";
        }

        function getStatusTimeline(order) {
            const status = order.status;
            const stages = [
                { label: "Chờ xác nhận", key: "pending" },
                { label: "Đã gán cửa hàng", key: "assigned" },
                { label: "Đang chuẩn bị", key: "preparing" },
                { label: "Đang giao", key: "delivering" },
                { label: "Đã giao", key: "completed" }
            ];

            const statusLower = status?.toLowerCase() || "pending";
            
            if (statusLower === 'cancelled') {
                return `
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px; margin-left:2px;">
                        <div style="width:12px; height:12px; background:#ef4444; border-radius:50%;"></div>
                        <strong style="font-size:16px; color:#ef4444;">Đơn hàng đã bị hủy</strong>
                    </div>
                `;
            }

            const currentIndex = stages.findIndex(s => s.key === statusLower);

            const titleHtml = `
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px; margin-left:2px;">
                    <div style="width:12px; height:12px; background:#16a34a; border-radius:50%;"></div>
                    <strong style="font-size:16px; color:#16a34a;">Trạng thái: ${getStatusBadge(status)}</strong>
                </div>
            `;

            const timelineHtml = stages.map((stage, index) => {
                const isComplete = index < currentIndex || (statusLower === 'completed');
                const isActive = index === currentIndex;
                const dotClass = isComplete ? "timeline-dot complete" : isActive ? "timeline-dot active" : "timeline-dot";

                return `
                    <div class="timeline-item">
                        <div class="${dotClass}"></div>
                        <div class="timeline-content">
                            <p class="status-label">${stage.label}</p>
                            ${(isComplete || isActive) && index === 0 ? `<p class="status-time">${new Date(order.created_at).toLocaleString('vi-VN')}</p>` : ''}
                        </div>
                    </div>
                `;
            }).join("");

            return titleHtml + '<div class="status-timeline">' + timelineHtml + '</div>';
        }

        function renderActiveOrderDetails(order) {
            const $details = $("#activeOrderDetails");
            const $timeline = $("#activeOrderTimeline");
            
            if (!order) {
                $details.hide();
                $timeline.html(`
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px; margin-left:2px;">
                        <div style="width:12px; height:12px; background:#16a34a; border-radius:50%;"></div>
                        <strong style="font-size:16px;">Chưa có đơn được chọn</strong>
                    </div>
                `);
                return;
            }

            // Render Details
            $details.show();
            let itemsHtml = '';
            if (order.items && order.items.length) {
                itemsHtml = `
                    <div style="margin-top: 15px; border-top: 1px solid #f1f5f9; padding-top: 15px;">
                        <h4 style="margin:0 0 10px 0; color:#1e293b;">Sản phẩm:</h4>
                        ${order.items.map(i => `<div style="display:flex; justify-content:space-between; margin-bottom:5px; font-size:14px;"><span>${i.qty}x ${i.product_name}</span><strong>${(i.unit_price * i.qty).toLocaleString('vi-VN')} ₫</strong></div>`).join('')}
                    </div>
                `;
            }

            $details.html(`
                <h3 style="margin-top:0; color:#1e293b; font-size:18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">Chi tiết đơn hàng</h3>
                <div style="margin-top: 15px; display:flex; flex-direction:column; gap:8px; font-size:14px; color:#475569;">
                    <div style="display:flex; justify-content:space-between;"><span>Mã đơn:</span><strong style="color:#1e293b;">${order.code}</strong></div>
                    <div style="display:flex; justify-content:space-between;"><span>Khách hàng:</span><strong>${order.customer_name}</strong></div>
                    <div style="display:flex; justify-content:space-between;"><span>Số điện thoại:</span><strong>${order.customer_phone}</strong></div>
                    <div style="display:flex; justify-content:space-between;"><span>Cửa hàng:</span><strong>${order.assigned_store?.name || order.assigned_store_id || 'N/A'}</strong></div>
                    <div style="display:flex; justify-content:space-between;"><span>Giao đến:</span><strong style="text-align:right; max-width:60%;">${order.customer_address}</strong></div>
                </div>
                ${itemsHtml}
                <div style="margin-top: 15px; border-top: 1px dashed #cbd5e1; padding-top: 15px; display:flex; justify-content:space-between; font-size:16px;">
                    <span>Tổng thanh toán:</span>
                    <strong style="color:#16a34a;">${(order.total || 0).toLocaleString('vi-VN')} ₫</strong>
                </div>
            `);

            // Render Timeline
            $timeline.html(getStatusTimeline(order));

            // Set active class on list
            $(".local-order-item").removeClass("active");
            $(`.local-order-item[data-code="${order.code}"]`).addClass("active");
        }

        function renderLocalOrdersList() {
            const $list = $("#trackingList");
            const $empty = $("#emptyTracking");

            if (localOrders.length === 0) {
                $list.hide();
                $empty.show();
                return;
            }

            $list.show();
            $empty.hide();
            $list.empty();

            localOrders.forEach(order => {
                const badge = getStatusBadge(order.status);
                const isActive = currentActiveOrder && currentActiveOrder.code === order.code;
                
                const card = $(`
                    <div class="local-order-item ${isActive ? 'active' : ''}" data-code="${order.code}">
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <strong style="font-size:16px; color:#1e293b;">${order.code}</strong>
                            <span style="font-size:13px; color:#64748b;">${new Date(order.created_at).toLocaleDateString('vi-VN')}</span>
                        </div>
                        <div style="text-align:right; display:flex; flex-direction:column; gap:4px;">
                            <span style="font-size:14px; font-weight:600; color:#334155;">${(order.total || 0).toLocaleString('vi-VN')} ₫</span>
                            <span style="font-size:12px; font-weight:600; color:#16a34a;">${badge}</span>
                        </div>
                    </div>
                `);

                card.on("click", function() {
                    currentActiveOrder = order;
                    renderActiveOrderDetails(order);
                });

                $list.append(card);
            });
        }

        $(document).ready(function() {
            // Auto select the first order if any
            if (localOrders.length > 0) {
                currentActiveOrder = localOrders[0];
            }
            
            renderLocalOrdersList();
            renderActiveOrderDetails(currentActiveOrder);
        });
    })();
</script>
