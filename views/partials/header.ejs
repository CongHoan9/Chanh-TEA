<header>
    <div class="Container">
        <nav class="navbar">
            <div class="nav-left">
                <a href="/" class="logo">
                    <span class="logo-yellow">Chanh</span><span class="logo-green">Tea</span>
                </a>
                <ul class="nav-links">
                    <li><a href="/">Trang chủ</a></li>
                    <li><a href="/menu">Sản phẩm</a></li>
                    <li><a href="/story">Giới thiệu</a></li>
                    <li><a href="/contact">Liên hệ</a></li>
                </ul>
            </div>
            <div class="nav-actions">
                <a class="tracking-btn" id="trackingBtn" href="/tracking" style="display:none;">
                    <svg width="22px" height="22px" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="#000000"/>
                    </svg>
                    <span id="trackingCount">0</span>
                </a>
                <a class="cart-a" href="/cart">
                    <svg fill="#000000" width="22px" height="22px" viewBox="0 0 24 24" fill="none">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M1 1C0.447715 1 0 1.44772 0 2C0 2.55228 0.447715 3 1 3H3.20647L5.98522 14.9089C6.39883 16.6816 7.95486 17.9464 9.76471 17.9983V18H17.5874C19.5362 18 21.2014 16.5956 21.5301 14.6747L22.7857 7.33734C22.9947 6.11571 22.0537 5 20.8143 5H5.72686L4.97384 1.77277C4.86824 1.32018 4.46475 1 4 1H1ZM6.19353 7L7.9329 14.4545C8.14411 15.3596 8.95109 16 9.88058 16H17.5874C18.5618 16 19.3944 15.2978 19.5588 14.3373L20.8143 7H6.19353Z" />
                        <path d="M8 23C9.10457 23 10 22.1046 10 21C10 19.8954 9.10457 19 8 19C6.89543 19 6 19.8954 6 21C6 22.1046 6.89543 23 8 23Z" />
                        <path d="M19 23C20.1046 23 21 22.1046 21 21C21 19.8954 20.1046 19 19 19C17.8954 19 17 19.8954 17 21C17 22.1046 17.8954 23 19 23Z" />                          
                    </svg>
                    <p id="count"></p>
                </a>
                <a class="login" onclick="document.getElementById('loginModal').style.display='flex'; " style="cursor:pointer;">
                    <svg width="20px" height="20px" viewBox="0 0 24 24" fill="none">
                        <path d="M15 4H18C19.1046 4 20 4.89543 20 6V18C20 19.1046 19.1046 20 18 20H15M11 16L15 12M15 12L11 8M15 12H3" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />                          
                    </svg>
                    <span>Đăng nhập</span>
                </a>

                <div class="menu-toggle" onclick="toggleMenu()">☰</div>             
            </div>
        </nav>
    </div>
    <div class="mobile-menu" id="mobileMenu">
        <form id="categoryFilter" class="Container">
            <label class="radio-item" onclick="window.location.href='/'">
                <input type="radio" name="category" value="Main" checked>
                <span>Trang Chủ</span>
            </label>
            <label onclick="window.location.href='/menu'" class="radio-item">
                <input type="radio" name="category" value="Menu">
                <span>Sản phẩm</span>
            </label>
            <label onclick="window.location.href='/story'" class="radio-item">
                <input type="radio" name="category" value="Story">
                <span>Giới thiệu</span>
            </label>
            <label onclick="window.location.href='/contact'" class="radio-item">
                <input type="radio" name="category" value="Contact">
                <span>Liên hệ</span>
            </label>
            <label class="radio-item">
                <input onclick="document.getElementById('loginModal').style.display='flex';  document.getElementById('mobileMenu').classList.remove('active');" type="radio" name="category" value="login">
                <span>Đăng nhập</span>
            </label>
        </form>
    </div>
</header>
